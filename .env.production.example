# Reference for deployment environment variables. Django production does NOT
# read this file or .env automatically. Set these values in the hosting service.
DJANGO_SETTINGS_MODULE=config.django.production
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=schedule.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://schedule.example.com

# Choose DATABASE_URL OR the PG fields. URL values take precedence.
# URL-encode special characters in a URL's username/password.
# DATABASE_URL=postgresql://user:encoded-password@db.example.com:5432/smart_schedule?sslmode=require
PGDATABASE=
PGUSER=
PGHOST=
PGPORT=5432
PGPASSWORD=
PGSSLMODE=require
# PGSSLROOTCERT=/path/to/database-ca.pem

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# Start with one hour; increase after validating HTTPS on the deployed domain.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# Enable only when a trusted reverse proxy strips/replaces this client header.
DJANGO_TRUST_X_FORWARDED_PROTO=false

# Optional Google/GitHub sign-in. Keep secrets private; see docs/social_auth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
