# Generate a local secret with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Empty host uses the local PostgreSQL Unix socket and Ubuntu peer authentication.
# Empty user defaults to your Linux username. No database password is needed
# when the PostgreSQL role has the same name as your Linux account.
PGDATABASE=smart_schedule
PGUSER=
PGHOST=
PGPORT=5432
PGPASSWORD=
