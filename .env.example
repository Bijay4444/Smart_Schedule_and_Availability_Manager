# Generate a local secret with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Empty host uses the local PostgreSQL Unix socket and Ubuntu peer authentication.
# Empty user defaults to your Linux username. No database password is needed
# when the PostgreSQL role has the same name as your Linux account.
PGDATABASE=smart_schedule
PGUSER=
PGHOST=
PGPORT=5432
PGPASSWORD=

# Optional alternative to the PG connection fields (takes precedence when set).
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_schedule
# PGSSLMODE=prefer
# PGSSLROOTCERT=/path/to/database-ca.pem

# Optional chat: create a key at https://console.groq.com/keys on the Free tier.
# Keep billing on Free; never commit your actual key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional social sign-in. Buttons appear only when both values are configured.
# Register Web OAuth apps; see docs/social_auth.md for exact callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
