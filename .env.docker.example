# Local Docker Compose preview only. Copy to .env.docker and generate both secrets.
# Always use: docker compose --env-file .env.docker ...
APP_PORT=8080
DJANGO_SECRET_KEY=
POSTGRES_DB=smart_schedule
POSTGRES_USER=smart_schedule
POSTGRES_PASSWORD=

# Optional Google/GitHub sign-in. Keep secrets private; see docs/social_auth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional read-only chatbot (keep provider account on the Free tier).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
